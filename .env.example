# FieldClear runs offline with the local heuristic planner.
# Copy this file to .env.local only if you are enabling Bedrock. Do not commit secrets.

# Set to true to let Amazon Bedrock Converse choose each tool call.
# Tools still execute in-process. If Bedrock errors, the local planner finishes the turn.
USE_BEDROCK=false

# Standard AWS credential chain. Used only when USE_BEDROCK=true.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bedrock Converse model id or inference profile. Nova Lite is a small default.
# Some accounts require an inference profile (the us. prefix) rather than the foundation model id.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Optional directory for the append-only audit log. Defaults to ./.data
# FIELD_DATA_DIR=

# Jev (TypeSafe System One) scores policy.check as a decision aid.
# Text and structured job state only. It does not clear spend or send a text.
# Leave the key unset to use the deterministic local fallback (no network call).
# Create a key at https://thejevai.com/settings/apikeys. Never commit it.
# JEV_API_KEY=
# Pin the model. jev-latest can move; jev-1.13.0 is the default.
# JEV_MODEL=jev-1.13.0
# true: call Jev and keep the shop-rule decision, logging both. Hard denies stay denies.
# JEV_DUAL_RUN=false
# true: Jev may hold or deny a ticket the shop rules would clear. It cannot override a hard deny,
# and it cannot turn a shop hold into a clear. Leave unset for the recorded demo.
# JEV_PRIMARY=false
