# FieldClear production uses Amazon Nova Lite on Bedrock.
# `npm run dev` stays on the local heuristic planner unless you set USE_BEDROCK=true.
# Copy this file to .env.local only when you are calling Bedrock. Do not commit secrets.

# false: local heuristic planner, no AWS call (also the offline demo and check:loop).
# true: Amazon Nova Lite on Bedrock in every environment, including `npm run dev`.
# Unset: production (`next start`, Vercel) uses Nova Lite; development stays local.
USE_BEDROCK=

# Bedrock region. The Nova Lite inference profile below is invoked from us-east-1.
AWS_REGION=us-east-1

# Nova Lite inference profile. Foundation model alternative: amazon.nova-lite-v1:0
# Do not set an anthropic.* or Claude model id. Marketplace Claude is not used.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Vercel: enable OIDC and set the IAM role that can invoke Nova Lite.
# The app assumes this role with @vercel/oidc-aws-credentials-provider.
# Do not store AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY on Vercel.
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/fieldclear-bedrock

# Optional directory for the append-only audit log. Defaults to ./.data
# FIELD_DATA_DIR=

# Jev (TypeSafe System One) scores policy.check as a decision aid.
# Text and structured job state only. It does not clear spend or send a text.
# Leave the key unset to use the deterministic local fallback (no network call).
# Create a key at https://thejevai.com/settings/apikeys. Never commit it.
# JEV_API_KEY=
# Pin the model. jev-latest can move; jev-1.13.0 is the default.
# JEV_MODEL=jev-1.13.0
# true: call Jev and keep the shop-rule decision, logging both. Hard denies stay denies.
# JEV_DUAL_RUN=false
# true: Jev may hold or deny a ticket the shop rules would clear. It cannot override a hard deny,
# and it cannot turn a shop hold into a clear. Leave unset for the recorded demo.
# JEV_PRIMARY=false
